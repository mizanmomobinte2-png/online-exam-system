<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.onlineexam.controller.ResultScreenController"
            prefWidth="1100" prefHeight="720" stylesheets="@/styles/style.css">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #1E2A3A;">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label text="Exam Result" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to Dashboard" onAction="#goDashboard" styleClass="primary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" alignment="TOP_CENTER">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <Label fx:id="examTitleLabel" text="Exam: -" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <HBox spacing="16" alignment="CENTER">
                <VBox styleClass="card" prefWidth="260">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Score" style="-fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="scoreLabel" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox styleClass="card" prefWidth="260">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Total Marks" style="-fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="totalLabel" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox styleClass="card" prefWidth="260">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Percentage" style="-fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="percentLabel" text="0%" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Label fx:id="passFailLabel" text="PASS" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="12" alignment="CENTER">
                <Button text="Review Answers" onAction="#goReview" styleClass="primary-button"/>
                <Button text="Go to Results History" onAction="#goHistory" styleClass="secondary-button"/>
            </HBox>

            <Label fx:id="noteLabel" text="" style="-fx-text-fill: #7f8c8d;"/>
        </VBox>
    </center>

</BorderPane>