<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.onlineexam.controller.ReviewScreenController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f4f6f8;">

    <children>
        <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
            <children>

                <HBox spacing="20" style="-fx-background-color: #1f3349; -fx-background-radius: 12; -fx-padding: 18;">
                    <children>
                        <VBox spacing="8">
                            <Label fx:id="examTitleLabel"
                                   text="Review Answers"
                                   style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"/>
                            <Label fx:id="summaryLabel"
                                   text="Score summary"
                                   style="-fx-text-fill: #dbe7f3; -fx-font-size: 15;"/>
                        </VBox>

                        <Button text="Close"
                                onAction="#closeWindow"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 24 10 24;"
                                HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>

                <TableView fx:id="reviewTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-background-radius: 12;">
                    <columns>
                        <TableColumn fx:id="noCol" text="#" prefWidth="60"/>
                        <TableColumn fx:id="questionCol" text="Question" prefWidth="440"/>
                        <TableColumn fx:id="yourAnswerCol" text="Your Answer" prefWidth="150"/>
                        <TableColumn fx:id="correctAnswerCol" text="Correct Answer" prefWidth="150"/>
                        <TableColumn fx:id="resultCol" text="Result" prefWidth="130"/>
                        <TableColumn fx:id="marksCol" text="Marks" prefWidth="100"/>
                    </columns>
                </TableView>

            </children>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>