<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.onlineexam.controller.TeacherExamListController"
            prefWidth="1450" prefHeight="900"
            style="-fx-background-color: #f5f7fb;">

    <children>

        <!-- Sidebar -->
        <VBox prefWidth="280"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              style="-fx-background-color: #24384f;">

            <children>
                <Label text="Teacher Portal"
                       style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold; -fx-padding: 40 0 10 30;"/>

                <Region prefHeight="10"/>
                <Region style="-fx-background-color: rgba(255,255,255,0.35);" prefHeight="1" maxWidth="240"/>

                <Label text="Dashboard"
                       onMouseClicked="#goDashboard"
                       style="-fx-text-fill: white; -fx-font-size: 18; -fx-padding: 30 0 0 50;"/>

                <Label text="Create Exam"
                       onMouseClicked="#goCreateExam"
                       style="-fx-text-fill: white; -fx-font-size: 18; -fx-padding: 30 0 0 50;"/>

                <Label text="My Exams"
                       onMouseClicked="#goMyExams"
                       style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 30 0 0 50;"/>

                <Label text="Results &amp; Reports"
                       onMouseClicked="#goResults"
                       style="-fx-text-fill: white; -fx-font-size: 18; -fx-padding: 30 0 0 50;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="Logout"
                       onMouseClicked="#logout"
                       style="-fx-text-fill: white; -fx-font-size: 18; -fx-padding: 0 0 40 50;"/>
            </children>
        </VBox>

        <!-- Main Content -->
        <VBox spacing="20"
              AnchorPane.topAnchor="35"
              AnchorPane.leftAnchor="320"
              AnchorPane.rightAnchor="35"
              AnchorPane.bottomAnchor="35">

            <children>

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <children>
                        <Label text="My Exams"
                               style="-fx-text-fill: #223b58; -fx-font-size: 34; -fx-font-weight: bold;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Refresh"
                                onAction="#refreshPage"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20 10 20;"/>

                        <Button text="+ Create New Exam"
                                onAction="#createNewExam"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20 10 20;"/>
                    </children>
                </HBox>

                <Label fx:id="summaryLabel"
                       text="Summary"
                       style="-fx-text-fill: #5d6d7e; -fx-font-size: 16; -fx-font-weight: bold;"/>

                <TableView fx:id="examTable"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10;">
                    <columns>
                        <TableColumn fx:id="titleCol" text="Exam Title" prefWidth="220"/>
                        <TableColumn fx:id="durationCol" text="Duration" prefWidth="100"/>
                        <TableColumn fx:id="totalCol" text="Total Marks" prefWidth="110"/>
                        <TableColumn fx:id="passingCol" text="Passing Marks" prefWidth="120"/>
                        <TableColumn fx:id="questionCountCol" text="Questions" prefWidth="100"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="createdAtCol" text="Created At" prefWidth="180"/>
                        <TableColumn fx:id="actionCol" text="Actions" prefWidth="430"/>
                    </columns>
                </TableView>

                <Label fx:id="noDataLabel"
                       text="No exams found."
                       visible="false"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 16; -fx-padding: 10 0 0 5;"/>

            </children>

            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
        </VBox>

    </children>
</AnchorPane>